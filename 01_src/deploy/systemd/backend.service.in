# Managed by Multi_Model_Inference for {project}
[Unit]
Description=Local assistant backend: {component}
PartOf=mmassistant.target
After={after}
Wants={wants}
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory={working_directory}
ExecStart={command}
{environment}
Restart=on-failure
RestartSec=5
SuccessExitStatus=130
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=20
SendSIGKILL=yes
MemoryAccounting=yes
CPUAccounting=yes
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mmassistant-{component}
